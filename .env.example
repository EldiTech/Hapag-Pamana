# Template for .env — copy this file to .env and fill in real values.
# .env is gitignored; this template is the one that's committed.
#
#   cp .env.example .env
#
# See lib/env.dart for how these are read, and each key's own file for what
# it's used for.

# Google Maps / Places API key (Google Cloud Console → APIs & Services →
# Credentials). Needs the Maps SDK for Android, Maps SDK for iOS, Places API
# and Geocoding API enabled, and should be restricted to this app's package
# name / bundle id once you're past local development.
#
# Read in three places, not just from Dart: lib/data/places_service.dart via
# lib/env.dart, android/app/build.gradle.kts (substituted into the manifest's
# com.google.android.geo.API_KEY), and ios/Runner/AppDelegate.swift (parsed
# out of the bundled .env before the engine starts). A blank value builds
# fine — only the address picker's map goes blank.
GOOGLE_MAPS_API_KEY=

# PayMongo API keys (PayMongo Dashboard → Developers → API keys). Use the
# sk_test_ / pk_test_ pair for development; only switch to sk_live_ /
# pk_live_ once payment confirmation has moved server-side (see the warning
# in lib/env.dart).
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Firebase Web SDK config (Firebase Console → Project settings → General →
# Your apps). These identify the project rather than grant access on their
# own — real access control is Firestore/Auth security rules — but are kept
# out of source alongside the other keys for consistency.
FIREBASE_ANDROID_API_KEY=
FIREBASE_WEB_API_KEY=
FIREBASE_IOS_API_KEY=
