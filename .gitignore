# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Built app binaries. `Download Web/` is the little download page the APK is
# handed out from, and the page itself belongs in the repo — but the binary
# does not: it is 60 MB of build output, regenerated by every release build,
# and git keeps every version of it forever. Publish the APK with the site,
# not through source control.
*.apk
*.aab
*.ipa

# Firebase CLI's local deploy cache — a per-machine record of what was last
# uploaded to hosting. Regenerated on every deploy and meaningless on anyone
# else's checkout, so it is noise in `git status` rather than shared state.
.firebase/

# Firebase service-account keys — unlimited access to the whole project,
# bypassing every Firestore rule. Never commit one.
**/serviceAccountKey.json
**/service-account*.json
*-firebase-adminsdk-*.json
node_modules/

# Claude Code's per-machine settings. The release-APK hook in here names an
# absolute powershell.exe path and an absolute repo path, so it is true only on
# the machine that wrote it. The script it runs (.claude/update-download-web.ps1)
# resolves its own paths and IS committed.
.claude/settings.local.json

# API keys and other secrets (PayMongo, Google Maps/Places, …) — see
# .env.example for the keys the app expects and lib/env.dart for how
# they're read. Never commit the real .env.
.env
